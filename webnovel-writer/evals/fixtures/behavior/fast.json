{
  "schema_version": "webnovel-behavior-evals/v1",
  "suite": "fast",
  "cases": [
    {
      "id": "skill_frontmatter",
      "type": "skill_frontmatter",
      "description": "Every skill has routeable frontmatter."
    },
    {
      "id": "skill_init_contract",
      "type": "skill_contract",
      "skill": "webnovel-init",
      "description": "/webnovel-init keeps the deep collection gate and avoids writing canon before confirmation.",
      "required": [
        "未过充分性闸门，不执行 `webnovel.py init`",
        "用户确认前不得写入",
        "python -X utf8"
      ]
    },
    {
      "id": "skill_plan_contract",
      "type": "skill_contract",
      "skill": "webnovel-plan",
      "description": "/webnovel-plan preserves outline blockers while producing volume-only planning artifacts.",
      "required": [
        "若发现总纲与设定冲突，先阻断",
        "placeholder-scan",
        "story-system"
      ]
    },
    {
      "id": "skill_chapter_plan_contract",
      "type": "skill_contract",
      "skill": "webnovel-chapter-plan",
      "description": "/webnovel-chapter-plan creates independent chapter outlines before refreshing chapter contracts.",
      "required": [
        "大纲/第N章-标题.md",
        "CBN",
        "CPNs",
        "CEN",
        "story-system",
        "--emit-runtime-contracts",
        "--chapter-planned"
      ]
    },
    {
      "id": "skill_volume_revise_contract",
      "type": "skill_contract",
      "skill": "webnovel-volume-revise",
      "description": "/webnovel-volume-revise confirms impact before editing and reloads the volume revision afterward.",
      "required": [
        "修改前先备份",
        "作者确认",
        "volume-reload",
        "不得自动覆盖独立章纲",
        "stale"
      ]
    },
    {
      "id": "volume_reload_contract",
      "type": "skill_contract",
      "skill": "webnovel-volume-reload",
      "description": "Manual volume outline edits require explicit revision reload and stale propagation.",
      "required": [
        "--volume",
        "--dry-run",
        "--backup-only",
        "manual_reload",
        "stale"
      ]
    },
    {
      "id": "skill_chapter_reload_contract",
      "type": "skill_contract",
      "skill": "webnovel-chapter-reload",
      "description": "Manual body edits require revision-bound reload, validation, and explicit commit confirmation.",
      "required": [
        "chapter-reload",
        "--dry-run",
        "--validate",
        "validation_input",
        "revision_projection_unsafe",
        "expected-previous",
        "不覆盖人工正文",
        "previous_chapter_revision_changed"
      ]
    },
    {
      "id": "skill_chapter_discard_contract",
      "type": "skill_contract",
      "skill": "webnovel-chapter-discard",
      "description": "Discarding a chapter is tail-only: drafts are archived then deleted, accepted chapters roll back to the previous version point without rewriting history.",
      "required": [
        "chapter-discard",
        "--dry-run",
        "--draft",
        "--rollback",
        "只允许抛弃最后一章",
        "ch{N-1}",
        "rewrite-from-start",
        ".webnovel/discarded/",
        "不删除任何提交",
        "downstream_chapters_exist",
        "working_tree_dirty",
        "chapter_committed"
      ],
      "forbidden_patterns": [
        "git reset --hard",
        "git checkout ch",
        "rm -rf"
      ]
    },
    {
      "id": "skill_write_contract",
      "type": "skill_contract",
      "skill": "webnovel-write",
      "description": "/webnovel-write calls runtime gates at natural boundaries.",
      "required": [
        "write-gate --chapter {chapter_num} --stage prewrite",
        "write-gate --chapter {chapter_num} --stage precommit",
        "write-gate --chapter {chapter_num} --stage postcommit",
        "projections retry --chapter {chapter_num}"
      ],
      "ordered": [
        [
          "write-gate --chapter {chapter_num} --stage precommit",
          "chapter-commit"
        ],
        [
          "chapter-commit",
          "write-gate --chapter {chapter_num} --stage postcommit"
        ]
      ]
    },
    {
      "id": "skill_review_contract",
      "type": "skill_contract",
      "skill": "webnovel-review",
      "description": "/webnovel-review preserves five-dimensional fact review without editorial scoring.",
      "required": [
        "必须通过 `Agent` 工具调用 `reviewer`",
        "review-pipeline",
        "blocking=true",
        "章节事实一致性与逻辑审查",
        "setting / timeline / continuity / character / logic",
        "不评分、不评价文笔、不建议情节改动"
      ],
      "forbidden_patterns": [
        "Quality Review Skill",
        "评估章节质量",
        "审查涉及爽点或钩子",
        "审查涉及多线交织"
      ]
    },
    {
      "id": "skill_query_contract",
      "type": "skill_contract",
      "skill": "webnovel-query",
      "description": "/webnovel-query stays read-only and prioritizes Story System sources.",
      "required": [
        "只读操作，不修改任何项目文件",
        "memory-contract load-context",
        "写前真源"
      ]
    },
    {
      "id": "skill_learn_contract",
      "type": "skill_contract",
      "skill": "webnovel-learn",
      "description": "/webnovel-learn writes through the project-memory CLI instead of manual JSON edits.",
      "required": [
        "project-memory add-pattern",
        "不删除旧记录，仅追加",
        "禁止使用 `Write`"
      ]
    },
    {
      "id": "skill_dashboard_contract",
      "type": "skill_contract",
      "skill": "webnovel-dashboard",
      "description": "/webnovel-dashboard remains read-only and exposes runtime health.",
      "required": [
        "只读",
        "/api/story-runtime/health",
        "-m dashboard.server"
      ]
    },
    {
      "id": "skill_doctor_contract",
      "type": "skill_contract",
      "skill": "webnovel-doctor",
      "description": "/webnovel-doctor stays read-only and uses project-status before detailed checks.",
      "required": [
        "只读诊断",
        "project-status",
        "doctor --format text"
      ]
    },
    {
      "id": "write_blocks_before_commit",
      "type": "write_blocking_gate",
      "description": "/webnovel-write keeps blocking review issues before commit and calls runtime gates."
    },
    {
      "id": "data_agent_artifact_only",
      "type": "data_agent_boundary",
      "description": "data-agent produces commit artifacts and does not directly write projection read-models."
    },
    {
      "id": "artifact_ownership",
      "type": "artifact_ownership",
      "description": "reviewer returns JSON while main flow writes review_results.json; data-agent writes only tmp artifacts."
    },
    {
      "id": "commit_drives_projection",
      "type": "commit_projection_runtime",
      "description": "ChapterCommitService remains the projection driver."
    },
    {
      "id": "dashboard_read_only",
      "type": "dashboard_read_only",
      "description": "Dashboard exposes GET-only API semantics."
    },
    {
      "id": "user_report_minimal_review_skipped",
      "type": "user_report_probe",
      "scenario": "minimal_review_skipped",
      "description": "/webnovel-write --minimal final report explains skipped reviewer instead of pretending full review passed."
    },
    {
      "id": "user_report_missing_data_artifacts",
      "type": "user_report_probe",
      "scenario": "missing_data_artifacts",
      "description": "Missing data-agent artifacts prevent a completed write report."
    },
    {
      "id": "user_report_projection_retry_auto_handled",
      "type": "user_report_probe",
      "scenario": "projection_retry_auto_handled",
      "description": "Projection retry success is reported as auto-handled."
    },
    {
      "id": "user_report_review_blocking_must_handle",
      "type": "user_report_probe",
      "scenario": "review_blocking_must_handle",
      "description": "Reviewer blocking issues are reported as must-handle."
    },
    {
      "id": "skill_audit_contract",
      "type": "skill_contract",
      "skill": "webnovel-audit",
      "description": "/webnovel-audit stays read-only, discloses threshold provenance, and refuses to conclude on insufficient samples.",
      "required": [
        "只读",
        "scope-audit",
        "--checks",
        "--baseline",
        "不对占比下结论",
        "题材 profile"
      ],
      "forbidden_patterns": [
        "自动修复",
        "自动改写"
      ]
    },
    {
      "id": "skill_style_learn_contract",
      "type": "skill_contract",
      "skill": "webnovel-style-learn",
      "description": "/webnovel-style-learn separates observed from target, defaults to accepted commits, and keeps script output out of manual edits.",
      "required": [
        "style-profile build",
        "现状 ≠ 目标",
        "--source all",
        "禁止手改",
        "accepted"
      ],
      "forbidden_patterns": [
        "改写正文",
        "直接编辑 JSON"
      ]
    }
  ]
}
